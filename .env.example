# ─────────────────────────────────────────────────────────────────────────────
# EastAfrica Export OS — Umgebungsvariablen
# Kopiere diese Datei als .env.local und trage deine Keys ein.
# .env.local wird niemals in Git committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Authentication + Datenbank) ─────────────────────────────────────
# 1. Erstelle ein Projekt auf https://supabase.com/dashboard
# 2. Gehe zu: Project Settings → API
# 3. Kopiere die Werte hier rein:
NEXT_PUBLIC_SUPABASE_URL=https://DEIN_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service Role Key — NUR für Server-seitige Admin-Aktionen (Nutzer einladen)
# Aus: Project Settings → API → service_role key
# NIEMALS im Browser/Frontend verwenden!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Resend (E-Mail-Versand) ───────────────────────────────────────────────────
# 1. Account erstellen auf https://resend.com
# 2. Domain verifizieren (oder Sandbox nutzen für Tests)
# 3. API-Key unter: https://resend.com/api-keys erstellen
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absender-Adresse (muss zu deiner verifizierten Resend-Domain passen)
# Für Tests ohne eigene Domain: onboarding@resend.dev
RESEND_FROM_EMAIL=EastAfrica Export OS <export@deinefirma.de>

# ── App-URL (für Auth-Callbacks und E-Mail-Links) ─────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Im Produktionsbetrieb:
# NEXT_PUBLIC_APP_URL=https://deine-domain.com

# ── KI-Provider (optional — serverseitige API-Keys) ──────────────────────────
# Wenn gesetzt, werden diese Keys für alle KI-Funktionen genutzt.
# Die Keys verlassen den Server nie — kein Nutzer sieht sie im Browser.
# Nutzer können in den Einstellungen eigene Keys als Fallback hinterlegen.
#
# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI (GPT-4o etc.): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
#
# DeepSeek (V3 / R1): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
